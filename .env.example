# Server
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
# Optional comma-separated trusted proxy IPs/subnets. Empty means direct access.
TRUST_PROXY=
# Optional. Leave empty to use data/runtime/anime_user.db.
ANIME_DB_PATH=
# Explicit, one-time corpus split; after migration always keep the paired .rag.db file.
ANIME_RAG_SEPARATE_STORE=false

# OpenAI-compatible model endpoint with native tool_calls support.
# Leave empty to use the basic website without model-powered Agent chat.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Vector RAG embeddings via a compatible /embeddings endpoint.
# bge-m3 is recommended for mixed Chinese/Japanese/English anime metadata.
# Use the exact provider model name and keep it consistent with the stored index.
# Example for a local OpenAI-compatible service: http://127.0.0.1:11434/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=32
# Leave 0 to use the model's native dimensions.
EMBEDDING_DIMENSIONS=0
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Hybrid RAG: vector 0.65 + keyword 0.25 + source trust 0.10.
RAG_ENABLED=true
# Approximate budget for decoded vector pages; 0 disables reuse, scans remain serialized.
RAG_DECODE_CACHE_MB=64
RAG_CANDIDATE_K=12
RAG_FINAL_K=6
RAG_MIN_SCORE=0.42
# Enable after the first `npm run rag:index` if metadata syncs should be
# embedded incrementally in the background.
RAG_AUTO_INDEX=false
RAG_AUTO_INDEX_BATCH=24
RAG_EXTERNAL_TTL_DAYS=30

# Agent guardrails
AGENT_TIMEOUT_MS=25000
AGENT_RUN_TIMEOUT_MS=120000
AGENT_TOOL_TIMEOUT_MS=30000
AGENT_MAX_TOKENS=2000
# Effective capacity is the smaller of this deployment limit and AGENT_CONTEXT_TOKEN_BUDGET.
# Verify the limit for your actual model and gateway before increasing it.
LLM_CONTEXT_WINDOW=128000
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_TOOL_CALLS=24
AGENT_READ_CONCURRENCY=3
# Enable only for a gateway that supports strict function schemas. Native tool_calls are required.
LLM_TOOL_STRICT=false
# Enable only after confirming that this provider endpoint supports forced function selection.
LLM_FORCE_TOOL_CHOICE=false
AGENT_HISTORY_MESSAGES=4096
AGENT_HISTORY_TOKEN_BUDGET=96000
AGENT_CONTEXT_TOKEN_BUDGET=128000
AGENT_CONTEXT_HIGH_WATERMARK=96000
AGENT_CONTEXT_LOW_WATERMARK=64000
AGENT_TOOL_RESERVE_TOKENS=12000
AGENT_SAFETY_RESERVE_TOKENS=4000
AGENT_COMPACTION_TIMEOUT_MS=15000
AGENT_BACKGROUND_COMPACTION=true
AGENT_TOOL_RESULT_TOKEN_BUDGET=2200
AGENT_SUMMARY_TOKEN_BUDGET=4000
AGENT_MEMORY_WRITE_TOKEN_BUDGET=48000
AGENT_RELATED_MEMORY_TOKEN_BUDGET=3000
AGENT_USER_STORE_TOKEN_BUDGET=1600
AGENT_RELATED_MEMORY_LIMIT=4
AGENT_SUMMARY_CHAR_LIMIT=24000
# Optional administrator-only key for /api/agent/diagnostics.
AGENT_DIAGNOSTICS_KEY=
# Comma-separated account IDs or emails allowed to open the Agent dashboard.
# Keep this explicit; normal logged-in users must not see cross-user telemetry.
AGENT_ADMIN_USER_IDS=
AGENT_ADMIN_EMAILS=

# Optional web search for anime evidence, including stable facts and latest news.
# Get a key from https://app.tavily.com/home and keep the real key only in .env.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_STRICT_DOMAINS=false
WEB_SEARCH_ALLOWED_DOMAINS=animenewsnetwork.com,crunchyroll.com,anilist.co,myanimelist.net,kadokawa.co.jp,shinkaiworks.com,toho.co.jp,aniplex.co.jp,ghibli.jp,re-zero-anime.jp

# Optional email verification SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# DanDanPlay Open Platform credentials. Used by the App danmaku proxy so
# release builds do not need to embed the API key.
DANDANAPI_APPID=
DANDANAPI_KEY=

# Required outer access gate. Password must be exactly 18 characters and
# contain uppercase, lowercase, number and symbol. Generate a unique secret.
ACCESS_GATE_PASSWORD=
ACCESS_GATE_SECRET=
ACCESS_GATE_TOKEN_TTL=30d

# Optional account for the AniWorld source bridge's current CYCANI playback API.
# Keep real values only in the server's private .env file.
CYCANI_USERNAME=
CYCANI_PASSWORD=
CYCANI_AUTH_TOKEN=

# Client update publishing. Upload files named like AniWorld_android_2.2.9.apk
# or AniWorld_windows_2.2.9.zip; the newest version for each platform is served.
APP_RELEASE_DIR=./data/releases
APP_UPDATE_NOTES=
APP_UPDATE_RELEASE_URL=
