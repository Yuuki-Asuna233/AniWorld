{
  "name": "anime-site",
  "version": "1.0.0",
  "description": "AniWorld web, API, agent and Flutter client monorepo",
  "main": "apps/server/server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node apps/server/server.js",
    "sync": "node scripts/data/sync-db.js",
    "sync-full": "node scripts/data/sync-db.js --full",
    "sync-oi": "node scripts/data/sync-db.js --oi-only",
    "data:export": "node scripts/data/export-catalog.js",
    "data:import": "node scripts/data/import-catalog.js",
    "test": "node tests/server/agent-memory-regression.js && node tests/server/agent-regression.js && node tests/server/agent-capability-matrix.js && node tests/server/rag-regression.js",
    "test:agent": "node tests/server/agent-regression.js && node tests/server/agent-capability-matrix.js",
    "test:agent-capability": "node tests/server/agent-capability-matrix.js",
    "test:agent-memory": "node tests/server/agent-memory-regression.js",
    "test:rag": "node tests/server/rag-regression.js",
    "rag:index": "node scripts/data/build-rag-index.js",
    "rag:status": "node scripts/data/build-rag-index.js --status",
    "test:anime-identity": "node tests/server/anime-identity-regression.js",
    "test:media-features": "node tests/server/media-features-regression.js",
    "test:access-gate": "node tests/server/access-gate-regression.js",
    "test:auth": "node tests/server/auth-regression.js",
    "test:app-update": "node tests/server/app-update-regression.js",
    "app:install": "cd apps/client && flutter pub get",
    "app:test": "cd apps/client && flutter test",
    "app:build:android": "cd apps/client && flutter build apk --release",
    "app:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/build-app-release.ps1",
    "app:run:android": "cd apps/client && flutter run",
    "pc:install": "cd apps/client && flutter pub get",
    "pc:run": "cd apps/client && flutter run -d windows",
    "pc:build:windows": "cd apps/client && flutter build windows --release",
    "pc:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/build-windows-release.ps1",
    "setup:env": "node scripts/setup-env.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "opencc-js": "^1.3.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.1"
  }
}
